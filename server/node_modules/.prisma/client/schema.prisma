generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  branch          String?
  college         String?
  graduationYear  Int?
  targetCompanies String[]
  createdAt       DateTime @default(now())

  resumes           Resume[]
  quizAttempts      QuizAttempt[]
  codingSubmissions CodingSubmission[]
  mockTestResults   MockTestResult[]
  progress          UserProgress?
}

model Resume {
  id         Int      @id @default(autoincrement())
  fileUrl    String
  atsScore   Int?
  feedback   String?
  uploadedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id            Int      @id @default(autoincrement())
  type          String // aptitude or coding
  title         String
  description   String
  difficulty    String
  topic         String
  companyTag    String?
  options       String[]
  correctAnswer String?
  explanation   String?
  sampleInput   String?
  sampleOutput  String?
  createdAt     DateTime @default(now())

  testCases     TestCase[]
  quizAttempts  QuizAttempt[]
  codingSubs    CodingSubmission[]
  mockQuestions MockTestQuestion[]
}

model TestCase {
  id             Int    @id @default(autoincrement())
  input          String
  expectedOutput String

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             Int      @id @default(autoincrement())
  selectedAnswer String
  isCorrect      Boolean
  timeTaken      Int
  attemptedAt    DateTime @default(now())

  userId     Int
  questionId Int

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
}

model CodingSubmission {
  id            Int      @id @default(autoincrement())
  code          String
  language      String
  status        String // passed / failed
  executionTime Float?
  submittedAt   DateTime @default(now())

  userId     Int
  questionId Int

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
}

model MockTest {
  id        Int      @id @default(autoincrement())
  title     String
  duration  Int
  createdAt DateTime @default(now())

  questions MockTestQuestion[]
  results   MockTestResult[]
}

model MockTestQuestion {
  id Int @id @default(autoincrement())

  testId     Int
  questionId Int

  test     MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
}

model MockTestResult {
  id          Int      @id @default(autoincrement())
  score       Int
  rank        Int?
  completedAt DateTime @default(now())

  testId Int
  userId Int

  test MockTest @relation(fields: [testId], references: [id])
  user User     @relation(fields: [userId], references: [id])
}

model Company {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  aptitudeWeight Int?
  codingWeight   Int?
  description    String?
}

model UserProgress {
  id               Int      @id @default(autoincrement())
  aptitudeAccuracy Float?
  codingAccuracy   Float?
  weakTopics       String[]
  strongTopics     String[]
  updatedAt        DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}
